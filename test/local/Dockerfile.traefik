# syntax=docker/dockerfile:1.2
# Build context: repo root  (docker compose sets context: ../..)
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src

# Warm the module cache before copying source so layer is reused on code-only changes.
# go.mod has a local replace: ./pkg/config/dynamic/ext — copy it first so
# go mod download can resolve the local path without needing the full source.
COPY go.mod go.sum ./
COPY pkg/config/dynamic/ext/ ./pkg/config/dynamic/ext/
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
        -ldflags "-s -w -X github.com/traefik/traefik/v3/pkg/version.Version=dev-coraza" \
        -installsuffix nocgo \
        -o /traefik \
        ./cmd/traefik

# ---- runtime image ----
FROM alpine:3.23

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /traefik /traefik

EXPOSE 80 8080
VOLUME ["/tmp"]
ENTRYPOINT ["/traefik"]
